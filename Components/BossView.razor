@using VectorType.Models

<div class="absolute left-1/2 -translate-x-1/2 top-4 w-11/12 max-w-4xl flex flex-col items-center z-20 pointer-events-none select-none">
    
    <!-- Boss Warship Vector Graphic -->
    <div class="relative w-36 h-24 mb-2 flex items-center justify-center drop-shadow-[0_0_20px_rgba(189,0,255,0.8)]">
        <svg viewBox="0 0 120 70" class="w-32 h-20">
            <!-- Outer Shield Ring -->
            <ellipse cx="60" cy="35" rx="55" ry="25" fill="none" stroke="#bd00ff" stroke-width="2" stroke-dasharray="6,4" class="animate-pulse" />
            <!-- Main Dreadnought Hull -->
            <polygon points="60,65 110,25 95,5 25,5 10,25" fill="#120524" stroke="#ff007f" stroke-width="2.5" stroke-linejoin="round" />
            <!-- Inner Cyber Circuit lines -->
            <line x1="30" y1="20" x2="60" y2="45" stroke="#00f0ff" stroke-width="1.5" />
            <line x1="90" y1="20" x2="60" y2="45" stroke="#00f0ff" stroke-width="1.5" />
            <polygon points="60,20 75,35 60,50 45,35" fill="#bd00ff" fill-opacity="0.5" stroke="#00f0ff" stroke-width="2" />
            <!-- Core Reactor -->
            <circle cx="60" cy="35" r="7" fill="#ffffff" class="animate-ping" />
            <circle cx="60" cy="35" r="5" fill="#00f0ff" />
            <!-- Wing Turrets -->
            <line x1="20" y1="15" x2="20" y2="40" stroke="#ff007f" stroke-width="3" />
            <line x1="100" y1="15" x2="100" y2="40" stroke="#ff007f" stroke-width="3" />
        </svg>

        <!-- Lock Reticle -->
        <div class="absolute inset-0 border border-neon-pink/50 rounded-lg pointer-events-none animate-pulse"></div>
    </div>

    <!-- Boss Header & Health / Timer Bar -->
    <div class="w-full bg-[#0d071c]/90 backdrop-blur-md border-2 border-neon-pink/60 rounded-xl p-4 shadow-[0_0_25px_rgba(255,0,127,0.35)] flex flex-col gap-3">
        
        <!-- Name & Timer -->
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-full bg-neon-pink animate-ping"></span>
                <span class="font-orbitron font-black text-lg tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-neon-pink via-white to-neon-purple">
                    @Boss.BossName
                </span>
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-neon-pink/20 text-neon-pink border border-neon-pink/40 uppercase">
                    Core Threat
                </span>
            </div>

            <!-- Time Limit Countdown -->
            <div class="flex items-center gap-2">
                <span class="text-xs font-mono text-slate-400 uppercase tracking-widest">Core Surge In:</span>
                <span class="font-orbitron font-black text-base @(Boss.TimeRemainingSeconds <= 10 ? "text-red-500 animate-ping" : "text-neon-amber")">
                    @Boss.TimeRemainingSeconds.ToString("F1")s
                </span>
            </div>
        </div>

        <!-- Boss Health Bar -->
        <div class="flex flex-col gap-1">
            <div class="flex justify-between text-xs font-mono">
                <span class="text-neon-pink font-bold">HULL INTEGRITY</span>
                <span class="text-slate-300 font-bold">@((int)Boss.HealthPercentage)%</span>
            </div>
            <div class="w-full h-3 bg-slate-900 rounded-full overflow-hidden border border-neon-pink/50 p-0.5 shadow-inner">
                <div class="h-full bg-gradient-to-r from-neon-purple via-neon-pink to-red-500 rounded-full transition-all duration-150 shadow-[0_0_12px_rgba(255,0,127,0.8)]"
                     style="width: @(Boss.HealthPercentage)%"></div>
            </div>
        </div>

        <!-- Boss Active Sentence Box -->
        <div class="mt-2 bg-[#05020a]/80 border border-neon-cyan/40 rounded-lg p-3 text-center">
            <span class="text-[10px] font-mono text-neon-cyan uppercase tracking-widest block mb-1">
                OVERRIDE SEQUENCE // TYPE FULL PROTOCOL SENTENCE
            </span>

            <div class="font-mono text-lg sm:text-2xl font-bold tracking-wider leading-relaxed flex flex-wrap justify-center gap-x-3 gap-y-1">
                @for (int w = 0; w < Boss.Words.Count; w++)
                {
                    var word = Boss.Words[w];
                    bool isCompleted = w < Boss.CurrentWordIndex;
                    bool isCurrent = w == Boss.CurrentWordIndex;

                    <span class="inline-block px-1 rounded @(isCompleted ? "text-neon-green/90 drop-shadow-[0_0_8px_rgba(0,255,102,0.6)]" : isCurrent ? "bg-neon-cyan/15 text-white border-b-2 border-neon-cyan shadow-[0_0_10px_rgba(0,240,255,0.5)]" : "text-slate-500")">
                        @if (isCompleted)
                        {
                            <span class="line-through decoration-neon-green/60">@word</span>
                        }
                        else if (isCurrent)
                        {
                            <!-- Render character progress within the current word -->
                            @RenderCurrentWordProgress(word)
                        }
                        else
                        {
                            <span>@word</span>
                        }
                    </span>
                }
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired] public required BossEnemy Boss { get; set; }

    private RenderFragment RenderCurrentWordProgress(string word) => builder =>
    {
        // Calculate how many characters of the current word have been typed
        int charsBeforeCurrentWord = 0;
        for (int i = 0; i < Boss.CurrentWordIndex; i++)
        {
            charsBeforeCurrentWord += Boss.Words[i].Length + 1; // +1 for space
        }

        int typedInWord = Math.Clamp(Boss.TypedProgress - charsBeforeCurrentWord, 0, word.Length);

        string typedPart = word[..typedInWord];
        string remainingPart = word[typedInWord..];

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "text-neon-green font-black drop-shadow-[0_0_6px_rgba(0,255,102,0.9)]");
        builder.AddContent(2, typedPart);
        builder.CloseElement();

        if (remainingPart.Length > 0)
        {
            // First character is active
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "text-white underline decoration-neon-cyan decoration-2 font-black");
            builder.AddContent(5, remainingPart[0]);
            builder.CloseElement();

            if (remainingPart.Length > 1)
            {
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "class", "text-slate-300");
                builder.AddContent(8, remainingPart[1..]);
                builder.CloseElement();
            }
        }
    };
}
