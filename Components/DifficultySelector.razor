@using VectorType.Models

<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#05070f]/90 backdrop-blur-lg select-none overflow-y-auto">
    <div class="w-full max-w-2xl bg-[#0b1021]/95 border-2 border-neon-cyan/40 rounded-2xl p-6 sm:p-8 shadow-[0_0_50px_rgba(0,240,255,0.25)] flex flex-col gap-6 relative">
        
        <!-- Corner Cyber Decals -->
        <span class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-neon-cyan"></span>
        <span class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-neon-cyan"></span>
        <span class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-neon-cyan"></span>
        <span class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-neon-cyan"></span>

        <!-- Game Title Banner -->
        <div class="text-center flex flex-col items-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neon-cyan/10 border border-neon-cyan/30 text-[11px] font-mono tracking-widest text-neon-cyan uppercase mb-2">
                <span class="w-2 h-2 rounded-full bg-neon-cyan animate-ping"></span>
                ARCADE TYPING PROTOCOL // C# ENGINE
            </div>
            <h1 class="text-4xl sm:text-5xl font-black font-orbitron tracking-widest uppercase text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-white to-neon-pink drop-shadow-[0_0_15px_rgba(0,240,255,0.7)]">
                VECTOR // TYPE
            </h1>
            <p class="text-slate-400 font-mono text-xs sm:text-sm mt-1 tracking-wider">
                Defend the core grid. Type words with laser precision to neutralize threats.
            </p>
        </div>

        <!-- Game Mode Selection Tabs -->
        <div class="flex flex-col gap-2">
            <span class="text-xs font-mono font-bold tracking-widest text-slate-300 uppercase">Select Mission Mode:</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button type="button" @onclick="() => SelectedMode = GameMode.Normal"
                        class="p-4 rounded-xl text-left border transition-all relative overflow-hidden @(SelectedMode == GameMode.Normal ? "bg-neon-cyan/15 border-neon-cyan shadow-[0_0_20px_rgba(0,240,255,0.3)]" : "bg-slate-900/60 border-slate-700/80 hover:border-slate-500")">
                    @if (SelectedMode == GameMode.Normal)
                    {
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-neon-cyan"></span>
                    }
                    <div class="font-orbitron font-extrabold text-base text-neon-cyan flex items-center gap-2">
                        <span>NORMAL MODE</span>
                    </div>
                    <p class="text-xs font-mono text-slate-400 mt-1">
                        Structured waves culminating in an epic Boss battle. Clear all waves and destroy the boss to achieve Victory.
                    </p>
                </button>

                <button type="button" @onclick="() => SelectedMode = GameMode.Endless"
                        class="p-4 rounded-xl text-left border transition-all relative overflow-hidden @(SelectedMode == GameMode.Endless ? "bg-neon-purple/20 border-neon-purple shadow-[0_0_20px_rgba(189,0,255,0.3)]" : "bg-slate-900/60 border-slate-700/80 hover:border-slate-500")">
                    @if (SelectedMode == GameMode.Endless)
                    {
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-neon-purple"></span>
                    }
                    <div class="font-orbitron font-extrabold text-base text-neon-purple flex items-center gap-2">
                        <span>ENDLESS MODE</span>
                    </div>
                    <p class="text-xs font-mono text-slate-400 mt-1">
                        Infinite scaling challenge. Enemies get faster and spawn more rapidly with periodic mini-boss encounters.
                    </p>
                </button>
            </div>
        </div>

        <!-- Difficulty Selection -->
        <div class="flex flex-col gap-2">
            <span class="text-xs font-mono font-bold tracking-widest text-slate-300 uppercase">Select Difficulty:</span>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <!-- Easy -->
                <button type="button" @onclick="() => SelectedDifficulty = Difficulty.Easy"
                        class="p-3.5 rounded-xl border text-left transition-all @(SelectedDifficulty == Difficulty.Easy ? "bg-neon-green/15 border-neon-green shadow-[0_0_15px_rgba(0,255,102,0.3)]" : "bg-slate-900/60 border-slate-700/80 hover:border-slate-500")">
                    <div class="font-orbitron font-bold text-sm text-neon-green flex items-center justify-between">
                        <span>EASY</span>
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neon-green/20">1.0x</span>
                    </div>
                    <div class="text-[11px] font-mono text-slate-400 mt-2 space-y-0.5">
                        <div>• Steady velocity</div>
                        <div>• Moderate spawn cadence</div>
                        <div>• 3–5 letter words</div>
                    </div>
                </button>

                <!-- Medium -->
                <button type="button" @onclick="() => SelectedDifficulty = Difficulty.Medium"
                        class="p-3.5 rounded-xl border text-left transition-all @(SelectedDifficulty == Difficulty.Medium ? "bg-neon-amber/15 border-neon-amber shadow-[0_0_15px_rgba(255,183,3,0.3)]" : "bg-slate-900/60 border-slate-700/80 hover:border-slate-500")">
                    <div class="font-orbitron font-bold text-sm text-neon-amber flex items-center justify-between">
                        <span>MEDIUM</span>
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neon-amber/20">1.5x</span>
                    </div>
                    <div class="text-[11px] font-mono text-slate-400 mt-2 space-y-0.5">
                        <div>• High enemy frequency</div>
                        <div>• Multi-lane swarm</div>
                        <div>• 4–8 letter words</div>
                    </div>
                </button>

                <!-- Hard -->
                <button type="button" @onclick="() => SelectedDifficulty = Difficulty.Hard"
                        class="p-3.5 rounded-xl border text-left transition-all @(SelectedDifficulty == Difficulty.Hard ? "bg-neon-pink/15 border-neon-pink shadow-[0_0_15px_rgba(255,0,127,0.3)]" : "bg-slate-900/60 border-slate-700/80 hover:border-slate-500")">
                    <div class="font-orbitron font-bold text-sm text-neon-pink flex items-center justify-between">
                        <span>HARD</span>
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neon-pink/20">2.2x</span>
                    </div>
                    <div class="text-[11px] font-mono text-slate-400 mt-2 space-y-0.5">
                        <div>• Rapid cascade swarm</div>
                        <div>• Heavy concurrent waves</div>
                        <div>• 6–12 letter technical</div>
                    </div>
                </button>
            </div>
        </div>

        <!-- Quick How to Play Guide -->
        <div class="bg-slate-950/70 border border-slate-800 rounded-xl p-3 text-xs font-mono text-slate-400 flex flex-col gap-1">
            <span class="text-neon-cyan font-bold tracking-wider uppercase text-[10px]">Command & Control Instructions:</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
                <div><span class="text-white font-bold">Automatic Lock-On:</span> Typing the first letter locks onto closest enemy.</div>
                <div><span class="text-white font-bold">Turret Laser:</span> Complete word to destroy enemy instantly.</div>
                <div><span class="text-white font-bold">Boss Sentence:</span> Type complete sentence before the core overload timer expires.</div>
                <div><span class="text-white font-bold">Shield Matrix:</span> Absorbs hits and regenerates if left undamaged.</div>
            </div>
        </div>

        <!-- Start Button -->
        <button type="button" @onclick="OnStartClicked"
                class="w-full py-4 rounded-xl font-orbitron font-black text-lg tracking-widest uppercase bg-gradient-to-r from-neon-cyan via-blue-500 to-neon-pink hover:from-white hover:to-neon-cyan text-slate-950 shadow-[0_0_30px_rgba(0,240,255,0.6)] hover:shadow-[0_0_40px_rgba(0,240,255,0.9)] transform hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            LAUNCH PROTOCOL
        </button>

    </div>
</div>

@code {
    [Parameter] public GameMode SelectedMode { get; set; } = GameMode.Normal;
    [Parameter] public Difficulty SelectedDifficulty { get; set; } = Difficulty.Medium;
    [Parameter] public EventCallback<(GameMode mode, Difficulty diff)> OnStart { get; set; }

    private async Task OnStartClicked()
    {
        await OnStart.InvokeAsync((SelectedMode, SelectedDifficulty));
    }
}
