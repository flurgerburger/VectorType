@page "/not-found"
@layout MainLayout

<div class="flex flex-col items-center justify-center min-h-screen bg-[#05070f] font-mono text-center p-6 select-none">
    <div class="p-8 max-w-md bg-[#0a1024] border border-neon-cyan/40 rounded-2xl shadow-[0_0_30px_rgba(0,240,255,0.2)] flex flex-col items-center gap-4">
        <span class="text-xs font-mono uppercase tracking-widest text-red-400">ERROR 404 // ROUTE DISCONNECTED</span>
        <h1 class="text-4xl font-black font-orbitron text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-pink">
            SECTOR VOID
        </h1>
        <p class="text-xs text-slate-400 font-mono">
            The coordinates you specified do not correspond to any active defense node.
        </p>
        <a href="/" class="mt-2 py-3 px-6 rounded-xl font-orbitron font-bold text-xs uppercase tracking-widest bg-neon-cyan text-slate-950 shadow-[0_0_15px_rgba(0,240,255,0.6)] hover:bg-white transition-all">
            RETURN TO GRID
        </a>
    </div>
</div>
